pipeline {
    agent any

    stages {
        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('2. Deploy to Apache') {
            steps {
                echo 'Deploying website files to Apache...'
                sh 'cp -rf * /var/www/html/'
            }
        }
    }

    post {
        success {
            echo 'Deployment successful! Site is live.'
        }
        failure {
            echo 'Pipeline failed during deployment.'
        }
    }
}
